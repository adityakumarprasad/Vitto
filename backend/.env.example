# ============================================================
# Backend environment variables (copy to .env and fill in values)
# ============================================================

# Server port
PORT=5000

# Node environment: development | production
NODE_ENV=development

# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://msme:msme123@localhost:5432/msme_lending?schema=public

# MongoDB connection string for decision audit history
MONGODB_URI=mongodb://localhost:27017/msme_lending

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:5173

# Simulated async decision delay in milliseconds
DECISION_DELAY_MS=3000
